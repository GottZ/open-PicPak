# Internal planning & engineering artifacts — never published (air-gap).
# Inventory/design/masterplan live here locally; only finished, stubbed docs
# and code are committed to the public repo.
.project/

# Scratch / build
*.tmp
*.log

# picpak-ops local operator config (real hosts/DSN/token live here, never committed).
# The committed source of truth is tools/picpak-ops/config.example.toml (placeholders only).
# Covered at the repo root too because the build defaults steer the operator to run from here.
picpak-ops.toml
config.toml
*.local.toml

# A33 Berry-WASM simulator: build products of firmware/sim/build.sh (E-A33-7 —
# build-stage output, not committed; the sources + firmware/sim/sim-manifest.json
# ARE committed). CI must run sim/build.sh before the admin image so the frontend
# stage embeds them via //go:embed all:dist.
backend/web/public/picpak-berry.mjs
backend/web/public/picpak-berry.wasm
backend/web/public/picpak-berry.wasm.br

# ESP-IDF build artifacts (sdkconfig.defaults is the tracked source of truth)
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/dependencies.lock
firmware/managed_components/

# Generated assets (source of truth: screens-src/gen_screens.py + fonts)
firmware/main/screens.h
firmware/screens-src/screens.h
firmware/screens-src/*.png
