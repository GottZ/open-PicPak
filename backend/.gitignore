# Air-gap: never commit real secrets / local state.
.env
# local bind-mount data (named volumes are managed by docker, not committed)
/data/
/ingest
*.log

# Frontend (A19): the bun toolchain output. Rule order matters — exclude the
# build output but keep the committed .gitkeep that satisfies //go:embed all:dist
# (D19.3), so a checkout with no bun build still compiles.
web/node_modules/
web/dist/*
!web/dist/.gitkeep

# FaaS worker (A24): Bun toolchain output. bun.lock is the committed source of truth.
worker/node_modules/
