# Copy to .env and fill in. .env is gitignored; NEVER commit real secrets (air-gap).
# These are local-dev placeholders; production values belong in the deployment's secret store.
POSTGRES_DB=picpak
POSTGRES_USER=picpak
POSTGRES_PASSWORD=change_me_dev_only
GRAFANA_ADMIN_PASSWORD=change_me_dev_only
# legacy ingest path token (the <token> in /<token>/pp). Per-device HOTP auth supersedes this later.
INGEST_TOKEN=change_me_dev_only
