# The ONE open-picpak backend image (A35 / DECISIONS §A35): the merged Go binary (cmd/backend —
# admin control plane + public device ingest + faas-supervisor logic) with the Svelte 5 SPA
# (backend/web) embedded via //go:embed all:dist. A bun frontend stage builds web/dist ahead of the
# Go build (svelte-check is the hard gate, run before vite build so type errors never reach the image).
# faas-worker + faas-egress stay separate images (sandbox). CGO-free static on scratch (no shell).

# --- frontend stage: build the SPA ---
FROM oven/bun:1-alpine AS frontend
WORKDIR /web
# deps first (cache layer): only re-installs when package.json / bun.lock / project.inlang move.
# project.inlang must ride this layer: the paraglide-js postinstall hook compiles the inlang
# project on install, so a deps-only layer without it fails the whole build (lead finding #12).
COPY web/package.json web/bun.lock ./
COPY web/project.inlang ./project.inlang
RUN bun install --frozen-lockfile
COPY web/ ./
# svelte-check (bun run check) BEFORE vite build — a type error fails the image.
RUN bun run check && bun run build

# --- go build stage ---
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Overlay the built SPA over the committed dist/.gitkeep placeholder, so
# //go:embed all:dist embeds the real production build (not the 503 stub).
COPY --from=frontend /web/dist ./web/dist
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/app ./cmd/backend

FROM scratch
COPY --from=build /out/app /app
USER 65534:65534
ENTRYPOINT ["/app"]
