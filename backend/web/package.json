{
  "name": "open-picpak-admin-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "postinstall": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "check": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.21.0",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.12.3",
    "eventsource-parser": "3.1.0",
    "sv-router": "0.16.3",
    "svelte": "5.56.3",
    "svelte-check": "4.6.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vite-plugin-compression2": "2.5.3",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.0",
    "@codemirror/view": "6.43.4",
    "@lezer/highlight": "1.2.3"
  }
}
